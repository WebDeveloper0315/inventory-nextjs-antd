# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored and must NEVER be committed.

# MongoDB connection string
DB_URI=mongodb://127.0.0.1:27017/inventory-nextjs-antd

# Secret used to sign auth tokens. Generate a strong one, e.g.:
#   openssl rand -base64 48
JWT_SECRET=

# Public path (served to the browser) where product images live.
NEXT_PUBLIC_IMAGES_PATH=/productImage
